{
  "permissions": {
    "additionalDirectories": [
      "../.."
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": false,
    "agent-skills@addy-agent-skills": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Read|Grep|Glob|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/../../.claude/hooks/guard.js\""
          }
        ]
      }
    ]
  }
}
